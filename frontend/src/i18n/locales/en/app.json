  "presets": {
    "modalEyebrow": "MODEL PRESETS",
    "modalTitle": "Start from a reliable structure",
    "apply": "Apply preset",
    "benefitLabel": "Benefit:",
    "tradeoffLabel": "Tradeoff:",
    "base": {
      "name": "{{arch}} · Recommended base",
      "benefit": "short validated structure to start",
      "tradeoff": "limited capacity for complex problems"
    },
    "regularized": {
      "mlp": {
        "name": "MLP · Regularized",
        "description": "Two dense layers with BatchNorm and Dropout for tabular data with more variation.",
        "benefit": "better overfitting control",
        "tradeoff": "trains slightly slower"
      },
      "unet": {
        "name": "U-Net · Normalized",
        "description": "Adds BatchNorm, activation and Dropout at the bottleneck for more stable segmentation.",
        "benefit": "better generalization on varied datasets",
        "tradeoff": "trains slower"
      }
    },
    "compact": {
      "name": "MLP · Compact",
      "description": "One small hidden layer to iterate quickly or work with little data.",
      "benefit": "fast to train and easy to interpret",
      "tradeoff": "lower representation capacity"
    },
    "standard": {
      "name": "CNN · Standard classifier",
      "description": "Two Conv–BatchNorm–ReLU blocks with pooling and global average. Good starting point for real images.",
      "benefit": "combines capacity, stability and moderate size",
      "tradeoff": "requires more data than base"
    },
    "deep_regularized": {
      "name": "CNN · Deep with regularization",
      "description": "Four convolutions, two spatial scales and Dropout 2D for more demanding visual classification.",
      "benefit": "detects more complex visual patterns",
      "tradeoff": "more parameters and higher overfitting risk"
    },
    "resnet": {
      "name": "CNN · Residual block",
      "description": "Two convolutions and a fully visible identity branch.",
      "benefit": "makes training deeper networks easier",
      "tradeoff": "branches must keep compatible shapes"
    },
    "gru": {
      "name": "Recurrent · GRU",
      "description": "Compact recurrent unit without separate cell state.",
      "benefit": "fewer parameters than LSTM",
      "tradeoff": "may represent less memory"
    },
    "rnn": {
      "name": "Recurrent · Simple RNN",
      "description": "Classic recurrence with tanh activation.",
      "benefit": "educational and lightweight structure",
      "tradeoff": "poorer long-range dependency memory"
    },
    "bidirectional": {
      "name": "LSTM · Bidirectional",
      "description": "Reads the sequence in both directions before producing the final prediction.",
      "benefit": "uses past and future context",
      "tradeoff": "not appropriate for strictly real-time prediction"
    },
    "stacked": {
      "name": "LSTM · Stacked",
      "description": "Two recurrent layers with Dropout for richer temporal dynamics.",
      "benefit": "more capacity for complex dependencies",
      "tradeoff": "slower to train"
    },
    "light": {
      "name": "U-Net · Light",
      "description": "Compact encoder–decoder to quickly try masks and segmentation formats.",
      "benefit": "uses less memory",
      "tradeoff": "loses detail in complex scenes"
    }
  },
