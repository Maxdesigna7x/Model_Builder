{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelBuilder",
  "version": "0.1.0",
  "identifier": "com.modelbuilder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ModelBuilder", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 650, "center": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": { "../backend": "backend" }
  }
}
